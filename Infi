------------------------------------------------
-- WALK SPEED LOGIC
------------------------------------------------
btn.MouseButton1Click:Connect(function()
	Config.WalkSpeedEnabled = not Config.WalkSpeedEnabled
	btn.Text = Config.WalkSpeedEnabled and "ON" or "OFF"
	Config.WalkSpeedValue = tonumber(spBox.Text) or Config.WalkSpeedValue
end)

local function updateWalkSpeed(humanoid)
	Run.RenderStepped:Connect(function()
		if Config.WalkSpeedEnabled and humanoid then
			humanoid.WalkSpeed = Config.WalkSpeedValue
		end
	end)
end

if player.Character then
	local hum = player.Character:WaitForChild("Humanoid")
	updateWalkSpeed(hum)
end
player.CharacterAdded:Connect(function(char)
	local hum = char:WaitForChild("Humanoid")
	updateWalkSpeed(hum)
end)

------------------------------------------------
-- TAG DONO
------------------------------------------------
local function createOwnerTag(plr)
	local head = plr.Character and plr.Character:FindFirstChild("Head")
	if not head then return end
	local billboard = Instance.new("BillboardGui", head)
	billboard.Size = UDim2.new(0,100,0,30)
	billboard.Adornee = head
	billboard.AlwaysOnTop = true

	local label = Instance.new("TextLabel", billboard)
	label.Size = UDim2.fromScale(1,1)
	label.Text = "DONO"
	label.Font = Enum.Font.CartoonBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromHSV(0,1,1)
	label.BackgroundTransparency = 1

	Run.RenderStepped:Connect(function()
		local h,s,v = tick()%5/5,1,1
		label.TextColor3 = Color3.fromHSV(h,s,v)
	end)
end

for _,plr in pairs(Players:GetPlayers()) do
	if plr.Name:lower() == "fhatom2" then
		createOwnerTag(plr)
	end
end
Players.PlayerAdded:Connect(function(plr)
	if plr.Name:lower() == "fhatom2" then
		plr.CharacterAdded:Connect(function()
			createOwnerTag(plr)
		end)
	end
end)
